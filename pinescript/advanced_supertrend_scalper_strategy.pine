//@version=5
// =============================================================================
// Supertrend Strategy (Always In + 3-TP Trade Management)
// -----------------------------------------------------------------------------
// Always-in Supertrend reversal with tick-based three-leg trade management:
//   * Enter long on flip up, short on flip down (auto-reverse on next flip)
//   * TP1 / TP2 / TP3 each take a configurable % off at +/- N ticks from entry
//   * After TP1 fills, runner stop logic is one of:
//       - None        -> no hard stop, ride until TP2 or next Supertrend flip
//       - Breakeven   -> stop at entry +/- buffer ticks
//       - Chandelier  -> stop at highest-high (long) / lowest-low (short)
//                        offset by N x ATR; volatility-adaptive, ratchets
//                        in profit, classic trend-rider trail
//   * After TP2 fills, runner stop trails with the Supertrend line, ratcheting
//     against the post-TP1 stop so it never moves backward
//   * If TP3 doesn't hit, the next Supertrend flip closes the runner
//   * Optional RTH session window gates new entries
// =============================================================================

strategy("Supertrend Strategy", shorttitle="ST Strat",
     overlay              = true,
     initial_capital      = 10000,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 10,
     pyramiding           = 0,
     commission_type      = strategy.commission.cash_per_order,
     commission_value     = 0,
     slippage             = 1,
     process_orders_on_close = true,
     calc_on_every_tick   = false,
     max_lines_count      = 500,
     max_bars_back        = 2000)

// -----------------------------------------------------------------------------
// Inputs - Supertrend
// -----------------------------------------------------------------------------
grpST   = "Supertrend"
atrLen  = input.int(10,   "ATR Length",     minval=2,   maxval=50,  step=1,   group=grpST)
atrMult = input.float(2.0, "ATR Multiplier", minval=0.5, maxval=5.0, step=0.1, group=grpST)

// -----------------------------------------------------------------------------
// Inputs - Targets & Stops (tick-based, three legs)
// -----------------------------------------------------------------------------
grpRisk    = "Targets & Stops"
useTp1     = input.bool(true, "Enable TP1",                                       group=grpRisk)
tp1Ticks   = input.int(8,  "TP1 Distance (ticks)",  minval=1, maxval=200, step=1, group=grpRisk)
tp1Pct     = input.int(33, "TP1 % of Position",     minval=1, maxval=98,  step=1, group=grpRisk)

useTp2     = input.bool(true, "Enable TP2",                                       group=grpRisk)
tp2Ticks   = input.int(16, "TP2 Distance (ticks)",  minval=1, maxval=400, step=1, group=grpRisk)
tp2Pct     = input.int(33, "TP2 % of Position",     minval=1, maxval=98,  step=1, group=grpRisk)

useTp3     = input.bool(true, "Enable TP3",                                       group=grpRisk)
tp3Ticks   = input.int(32, "TP3 Distance (ticks)",  minval=1, maxval=600, step=1, group=grpRisk)
tp3Pct     = input.int(34, "TP3 % of Position",     minval=1, maxval=98,  step=1, group=grpRisk,
     tooltip="The three TP percentages should sum to 100. The runner is the TP3 slice.")

tp1StopMode = input.string("None", "Runner Stop after TP1",
     options=["None", "Breakeven", "Chandelier"],                                 group=grpRisk,
     tooltip="What stop to apply to the runner once TP1 fills:\nNone = no hard stop, ride until TP2 or Supertrend flip.\nBreakeven = entry +/- buffer ticks.\nChandelier = highest-high / lowest-low offset by N x ATR; volatility-adaptive trail.")
beTicks    = input.int(1,  "Breakeven Buffer (ticks)", minval=0, maxval=50, step=1, group=grpRisk,
     tooltip="Used when Runner Stop = Breakeven. Offset from entry. 0 = exact entry. Positive locks in N ticks of profit.")
chandLen   = input.int(14, "Chandelier ATR Length",    minval=2, maxval=50, step=1, group=grpRisk,
     tooltip="Used when Runner Stop = Chandelier.")
chandMult  = input.float(3.0, "Chandelier ATR Multiplier", minval=0.5, maxval=8.0, step=0.1, group=grpRisk,
     tooltip="Used when Runner Stop = Chandelier. Stop = highest-high (long) / lowest-low (short) offset by this many ATRs.")

trailOnTp2 = input.bool(true, "Trail Runner SL with Supertrend after TP2",        group=grpRisk,
     tooltip="When on, after TP2 fills the runner trails the Supertrend line, ratcheting against the post-TP1 stop so it never moves backward.")
showLevels = input.bool(true, "Show TP / Stop Levels",                            group=grpRisk)
levelLen   = input.int(20, "Level Line Bars",        minval=1, maxval=200, step=1, group=grpRisk)

// -----------------------------------------------------------------------------
// Inputs - Session Filter (RTH window)
// -----------------------------------------------------------------------------
grpSess    = "Session Filter (RTH)"
useSession = input.bool(true,  "Restrict Entries to Session",                     group=grpSess)
sessTime   = input.session("0935-1555", "Active Session Window",                  group=grpSess,
     tooltip="Default 0935-1555 ET = US Futures/Cash RTH minus 5-min open/close edges. Set 0930-1600 for full RTH.")
useLunch   = input.bool(false, "Skip Midday Lunch Lull",                          group=grpSess)
lunchTime  = input.session("1200-1300", "Lunch Session to Exclude",               group=grpSess)
sessTz     = input.string("America/New_York", "Session Timezone",                 group=grpSess,
     options=["America/New_York", "America/Chicago", "Europe/London", "Asia/Tokyo", "exchange"])
flatAtClose = input.bool(true, "Flatten Position at Session Close",               group=grpSess,
     tooltip="When on, any open position is closed when the bar exits the active session.")

// -----------------------------------------------------------------------------
// Inputs - Visuals
// -----------------------------------------------------------------------------
grpViz     = "Visuals"
showSTLine = input.bool(true, "Plot Supertrend Line",                             group=grpViz)
colorBars  = input.bool(true, "Color Bars by Trend",                              group=grpViz)
showLabels = input.bool(true, "Show Entry Markers",                               group=grpViz)
bullCol    = input.color(color.new(#26a69a, 0), "Bull Color",                     group=grpViz)
bearCol    = input.color(color.new(#ef5350, 0), "Bear Color",                     group=grpViz)

// =============================================================================
// Supertrend
// =============================================================================
supertrend(simple int len, simple float mult) =>
    atrV = ta.atr(len)
    src  = (high + low) / 2.0
    upBasic = src + mult * atrV
    dnBasic = src - mult * atrV
    var float upBand = na
    var float dnBand = na
    var int   trnd   = 1
    upBand := na(upBand[1]) ? upBasic : (upBasic < upBand[1] or close[1] > upBand[1] ? upBasic : upBand[1])
    dnBand := na(dnBand[1]) ? dnBasic : (dnBasic > dnBand[1] or close[1] < dnBand[1] ? dnBasic : dnBand[1])
    trnd  := na(trnd[1]) ? 1 :
             trnd[1] == -1 and close > upBand[1] ? 1 :
             trnd[1] ==  1 and close < dnBand[1] ? -1 : trnd[1]
    stLine = trnd == 1 ? dnBand : upBand
    [stLine, trnd]

[stLine, dir] = supertrend(atrLen, atrMult)

flipUp = ta.change(dir) ==  2
flipDn = ta.change(dir) == -2

// Session gate (RTH window with optional lunch exclusion)
tzArg     = sessTz == "exchange" ? syminfo.timezone : sessTz
inRth     = not na(time(timeframe.period, sessTime,  tzArg))
inLunch   = useLunch and not na(time(timeframe.period, lunchTime, tzArg))
sessOk    = not useSession or (inRth and not inLunch)
exitedRth = useSession and inRth[1] and not inRth   // first bar after the session ends

// =============================================================================
// Entries + tick-based 3-TP trade management
// =============================================================================
tickSize   = syminfo.mintick
tp1Dist    = tp1Ticks * tickSize
tp2Dist    = tp2Ticks * tickSize
tp3Dist    = tp3Ticks * tickSize
beDist     = beTicks  * tickSize
chandATR   = ta.atr(chandLen)
chandDist  = chandMult * chandATR

var float entryPx = na
var float tp1Px   = na
var float tp2Px   = na
var float tp3Px   = na
var float bePx    = na
var bool  tp1Hit  = false
var bool  tp2Hit  = false
var bool  tp3Hit  = false

newLong  = flipUp and sessOk
newShort = flipDn and sessOk

if newLong
    entryPx := close
    tp1Px   := close + tp1Dist
    tp2Px   := close + tp2Dist
    tp3Px   := close + tp3Dist
    bePx    := close + beDist
    tp1Hit  := false
    tp2Hit  := false
    tp3Hit  := false
    strategy.entry("Long",  strategy.long,  comment="Long")

if newShort
    entryPx := close
    tp1Px   := close - tp1Dist
    tp2Px   := close - tp2Dist
    tp3Px   := close - tp3Dist
    bePx    := close - beDist
    tp1Hit  := false
    tp2Hit  := false
    tp3Hit  := false
    strategy.entry("Short", strategy.short, comment="Short")

// Track highest-high / lowest-low since position opened (for tick trail).
var float runHi = na
var float runLo = na
posJustOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
if posJustOpened
    runHi := high
    runLo := low
else if strategy.position_size != 0
    runHi := math.max(nz(runHi, high), high)
    runLo := math.min(nz(runLo, low),  low)
else
    runHi := na
    runLo := na

// Detect TP fills intrabar so we can advance the runner stop.
if strategy.position_size > 0
    if high >= tp1Px
        tp1Hit := true
    if high >= tp2Px
        tp2Hit := true
    if high >= tp3Px
        tp3Hit := true
if strategy.position_size < 0
    if low <= tp1Px
        tp1Hit := true
    if low <= tp2Px
        tp2Hit := true
    if low <= tp3Px
        tp3Hit := true
if strategy.position_size == 0
    tp1Hit := false
    tp2Hit := false
    tp3Hit := false

// Post-TP1 runner stop (mode-dependent). 'na' means no hard stop yet.
chandLongPx      = na(runHi) ? na : runHi - chandDist
chandShortPx     = na(runLo) ? na : runLo + chandDist
postTp1LongStop  = tp1Hit and tp1StopMode == "Breakeven" ? bePx : tp1Hit and tp1StopMode == "Chandelier" ? chandLongPx  : na
postTp1ShortStop = tp1Hit and tp1StopMode == "Breakeven" ? bePx : tp1Hit and tp1StopMode == "Chandelier" ? chandShortPx : na

// Post-TP2: Supertrend trail, ratcheting against the post-TP1 stop so it
// can only move in our favor (never gives back locked-in protection).
trailLongFloor   = na(postTp1LongStop)  ? entryPx : postTp1LongStop
trailShortFloor  = na(postTp1ShortStop) ? entryPx : postTp1ShortStop
longStop  = trailOnTp2 and tp2Hit ? math.max(stLine, trailLongFloor)  : postTp1LongStop
shortStop = trailOnTp2 and tp2Hit ? math.min(stLine, trailShortFloor) : postTp1ShortStop

// Place the three bracket exits each bar. Pine treats already-filled exits as
// no-ops and just refreshes the live ones with the current dynamic stop.
if strategy.position_size > 0
    if useTp1
        strategy.exit("X1", from_entry="Long", qty_percent=tp1Pct, limit=tp1Px, stop=longStop, comment_profit="TP1", comment_loss="Stop")
    if useTp2
        strategy.exit("X2", from_entry="Long", qty_percent=tp2Pct, limit=tp2Px, stop=longStop, comment_profit="TP2", comment_loss="Stop")
    if useTp3
        strategy.exit("X3", from_entry="Long", qty_percent=tp3Pct, limit=tp3Px, stop=longStop, comment_profit="TP3", comment_loss="Stop")

if strategy.position_size < 0
    if useTp1
        strategy.exit("X1", from_entry="Short", qty_percent=tp1Pct, limit=tp1Px, stop=shortStop, comment_profit="TP1", comment_loss="Stop")
    if useTp2
        strategy.exit("X2", from_entry="Short", qty_percent=tp2Pct, limit=tp2Px, stop=shortStop, comment_profit="TP2", comment_loss="Stop")
    if useTp3
        strategy.exit("X3", from_entry="Short", qty_percent=tp3Pct, limit=tp3Px, stop=shortStop, comment_profit="TP3", comment_loss="Stop")

// Flatten any open position when the active session ends.
if flatAtClose and exitedRth and strategy.position_size != 0
    strategy.close_all(comment="Sess End")

// =============================================================================
// Plots
// =============================================================================
plot(showSTLine and dir ==  1 ? stLine : na, "ST Up",
     color=bullCol, linewidth=2, style=plot.style_linebr)
plot(showSTLine and dir == -1 ? stLine : na, "ST Dn",
     color=bearCol, linewidth=2, style=plot.style_linebr)

barcolor(colorBars ? (dir == 1 ? bullCol : bearCol) : na)

plotshape(showLabels and newLong,  title="LONG",  style=shape.labelup,
     location=location.belowbar, color=bullCol, textcolor=color.white,
     text="L", size=size.tiny)
plotshape(showLabels and newShort, title="SHORT", style=shape.labeldown,
     location=location.abovebar, color=bearCol, textcolor=color.white,
     text="S", size=size.tiny)

// TP1 / TP2 / TP3 / BE level lines (entry-time, redrawn per trade).
// BE line is only meaningful in Breakeven mode; skip it otherwise.
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line beLine  = na

if showLevels and (newLong or newShort)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    line.delete(beLine)
    if useTp1
        tp1Line := line.new(bar_index, tp1Px, bar_index + levelLen, tp1Px,
             color=color.lime,   width=1, style=line.style_dotted)
    if useTp2
        tp2Line := line.new(bar_index, tp2Px, bar_index + levelLen, tp2Px,
             color=color.green,  width=1, style=line.style_dotted)
    if useTp3
        tp3Line := line.new(bar_index, tp3Px, bar_index + levelLen, tp3Px,
             color=color.teal,   width=2, style=line.style_dotted)
    if tp1StopMode == "Breakeven"
        beLine  := line.new(bar_index, bePx,  bar_index + levelLen, bePx,
             color=color.yellow, width=1, style=line.style_dashed)

// Active runner stop (visible only after it becomes non-na, i.e. post-TP1)
plot(strategy.position_size > 0 ? longStop  : na, "Long Stop",
     color=color.new(color.red, 30), style=plot.style_linebr, linewidth=2)
plot(strategy.position_size < 0 ? shortStop : na, "Short Stop",
     color=color.new(color.red, 30), style=plot.style_linebr, linewidth=2)
