//@version=5
// =============================================================================
// Supertrend Baseline Strategy (Always In + TP1 / Breakeven)
// -----------------------------------------------------------------------------
// Always-in Supertrend reversal with tick-based partial profit-take:
//   * Enter long on flip up, short on flip down (auto-reverse on next flip)
//   * TP1: take a configurable % of position off at +/- N ticks from entry
//   * After TP1 fills, move stop on the runner to entry +/- N ticks (BE buffer)
//   * Runner otherwise rides until the next Supertrend flip
//
// Optimizer-friendly: every numeric input has explicit minval/maxval/step.
// IS/OOS metrics table preserved for backtest evaluation.
// =============================================================================

strategy("Supertrend Baseline (Always In)", shorttitle="ST Baseline",
     overlay              = true,
     initial_capital      = 10000,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 10,
     pyramiding           = 0,
     commission_type      = strategy.commission.cash_per_order,
     commission_value     = 0,
     slippage             = 1,
     process_orders_on_close = true,
     calc_on_every_tick   = false,
     max_lines_count      = 500,
     max_bars_back        = 2000)

// -----------------------------------------------------------------------------
// Inputs - Supertrend
// -----------------------------------------------------------------------------
grpST   = "Supertrend"
atrLen  = input.int(10,   "ATR Length",     minval=2,   maxval=50,  step=1,   group=grpST)
atrMult = input.float(2.0, "ATR Multiplier", minval=0.5, maxval=5.0, step=0.1, group=grpST)

// -----------------------------------------------------------------------------
// Inputs - Targets & Stops (tick-based)
// -----------------------------------------------------------------------------
grpRisk    = "Targets & Stops"
useTp1     = input.bool(true, "Take Partial at TP1",                              group=grpRisk)
tp1Ticks   = input.int(8,  "TP1 Distance (ticks)",  minval=1, maxval=200, step=1, group=grpRisk)
tp1Pct     = input.int(50, "TP1 % of Position",     minval=1, maxval=99,  step=1, group=grpRisk,
     tooltip="Portion of the entry size taken off at TP1. Remainder rides on a breakeven stop.")
useBE      = input.bool(true, "Move Runner SL to Breakeven after TP1",            group=grpRisk)
beTicks    = input.int(1,  "Breakeven Buffer (ticks)", minval=0, maxval=50, step=1, group=grpRisk,
     tooltip="Offset from entry for the runner stop. 0 = exact entry. Positive locks in N ticks of profit; covers commissions/slippage.")
showLevels = input.bool(true, "Show TP1 / BE Levels",                             group=grpRisk)
levelLen   = input.int(20, "Level Line Bars",        minval=1, maxval=200, step=1, group=grpRisk)

// -----------------------------------------------------------------------------
// Inputs - Session Filter (RTH window)
// -----------------------------------------------------------------------------
grpSess    = "Session Filter (RTH)"
useSession = input.bool(true,  "Restrict Entries to Session",                     group=grpSess)
sessTime   = input.session("0935-1555", "Active Session Window",                  group=grpSess,
     tooltip="Default 0935-1555 ET = US Futures/Cash RTH minus 5-min open/close edges. Set 0930-1600 for full RTH.")
useLunch   = input.bool(false, "Skip Midday Lunch Lull",                          group=grpSess)
lunchTime  = input.session("1200-1300", "Lunch Session to Exclude",               group=grpSess)
sessTz     = input.string("America/New_York", "Session Timezone",                 group=grpSess,
     options=["America/New_York", "America/Chicago", "Europe/London", "Asia/Tokyo", "exchange"])
flatAtClose = input.bool(true, "Flatten Position at Session Close",               group=grpSess,
     tooltip="When on, any open position is closed when the bar exits the active session. Off = let the runner ride into after-hours until the next flip.")

// -----------------------------------------------------------------------------
// Inputs - Backtest Window (for IS/OOS attribution; not a signal filter)
// -----------------------------------------------------------------------------
grpWF     = "Backtest Window"
useWF     = input.bool(false, "Restrict Backtest to Date Range",                  group=grpWF)
isStart   = input.time(timestamp("2023-01-01 00:00 -0500"), "In-Sample Start",    group=grpWF)
isEnd     = input.time(timestamp("2024-06-30 23:59 -0500"), "In-Sample End / OOS Start", group=grpWF)
oosEnd    = input.time(timestamp("2025-12-31 23:59 -0500"), "Out-of-Sample End",  group=grpWF)
showWfTbl = input.bool(true,  "Show IS / OOS Metrics Table",                      group=grpWF)

// -----------------------------------------------------------------------------
// Inputs - Visuals
// -----------------------------------------------------------------------------
grpViz     = "Visuals"
showSTLine = input.bool(true, "Plot Supertrend Line",                             group=grpViz)
colorBars  = input.bool(true, "Color Bars by Trend",                              group=grpViz)
showLabels = input.bool(true, "Show Entry Markers",                               group=grpViz)
bullCol    = input.color(color.new(#26a69a, 0), "Bull Color",                     group=grpViz)
bearCol    = input.color(color.new(#ef5350, 0), "Bear Color",                     group=grpViz)

// =============================================================================
// Supertrend
// =============================================================================
supertrend(simple int len, simple float mult) =>
    atrV = ta.atr(len)
    src  = (high + low) / 2.0
    upBasic = src + mult * atrV
    dnBasic = src - mult * atrV
    var float upBand = na
    var float dnBand = na
    var int   trnd   = 1
    upBand := na(upBand[1]) ? upBasic : (upBasic < upBand[1] or close[1] > upBand[1] ? upBasic : upBand[1])
    dnBand := na(dnBand[1]) ? dnBasic : (dnBasic > dnBand[1] or close[1] < dnBand[1] ? dnBasic : dnBand[1])
    trnd  := na(trnd[1]) ? 1 :
             trnd[1] == -1 and close > upBand[1] ? 1 :
             trnd[1] ==  1 and close < dnBand[1] ? -1 : trnd[1]
    stLine = trnd == 1 ? dnBand : upBand
    [stLine, trnd]

[stLine, dir] = supertrend(atrLen, atrMult)

flipUp = ta.change(dir) ==  2
flipDn = ta.change(dir) == -2

// =============================================================================
// Backtest window (optional date scoping; no signal filters here)
// =============================================================================
inIS  = time >= isStart and time <  isEnd
inOOS = time >= isEnd   and time <= oosEnd
inAny = time >= isStart and time <= oosEnd
wfOk  = not useWF or inAny

// Session gate (RTH window with optional lunch exclusion)
tzArg     = sessTz == "exchange" ? syminfo.timezone : sessTz
inRth     = not na(time(timeframe.period, sessTime,  tzArg))
inLunch   = useLunch and not na(time(timeframe.period, lunchTime, tzArg))
sessOk    = not useSession or (inRth and not inLunch)
exitedRth = useSession and inRth[1] and not inRth   // first bar after the session ends

// =============================================================================
// Entries + tick-based TP1 / Breakeven trade management
// =============================================================================
tickSize = syminfo.mintick
tp1Dist  = tp1Ticks * tickSize
beDist   = beTicks  * tickSize

var float entryPx = na
var float tp1Px   = na
var float bePx    = na
var bool  tp1Hit  = false

newLong  = flipUp and wfOk and sessOk
newShort = flipDn and wfOk and sessOk

if newLong
    entryPx := close
    tp1Px   := close + tp1Dist
    bePx    := close + beDist
    tp1Hit  := false
    strategy.entry("Long",  strategy.long,  comment="Long")

if newShort
    entryPx := close
    tp1Px   := close - tp1Dist
    bePx    := close - beDist
    tp1Hit  := false
    strategy.entry("Short", strategy.short, comment="Short")

// Detect TP1 fills intrabar so we can switch the runner to a BE stop.
if strategy.position_size > 0 and high >= tp1Px
    tp1Hit := true
if strategy.position_size < 0 and low  <= tp1Px
    tp1Hit := true
if strategy.position_size == 0
    tp1Hit := false

// Place exits.
//   * Pre-TP1: limit-only partial at TP1 (no stop -> Supertrend handles reversal)
//   * Post-TP1: stop-only on the runner at the breakeven price
if strategy.position_size > 0
    if tp1Hit and useBE
        strategy.exit("BE",  from_entry="Long",  stop=bePx,  comment_loss="BE")
    else if useTp1
        strategy.exit("TP1", from_entry="Long",  qty_percent=tp1Pct, limit=tp1Px, comment_profit="TP1")

if strategy.position_size < 0
    if tp1Hit and useBE
        strategy.exit("BE",  from_entry="Short", stop=bePx,  comment_loss="BE")
    else if useTp1
        strategy.exit("TP1", from_entry="Short", qty_percent=tp1Pct, limit=tp1Px, comment_profit="TP1")

// Flatten any open position when the active session ends.
if flatAtClose and exitedRth and strategy.position_size != 0
    strategy.close_all(comment="Sess End")

// =============================================================================
// IS / OOS attribution (one row per closed sub-trade; partial fills count)
// =============================================================================
var int   isTrades  = 0
var int   isWins    = 0
var float isPnL     = 0.0
var float isGProf   = 0.0
var float isGLoss   = 0.0
var int   oosTrades = 0
var int   oosWins   = 0
var float oosPnL    = 0.0
var float oosGProf  = 0.0
var float oosGLoss  = 0.0
var int   lastClosed = 0

if strategy.closedtrades > lastClosed
    for i = lastClosed to strategy.closedtrades - 1
        et    = strategy.closedtrades.entry_time(i)
        pnl   = strategy.closedtrades.profit(i)
        isOne  = et >= isStart and et <  isEnd
        oosOne = et >= isEnd   and et <= oosEnd
        if isOne
            isTrades += 1
            isPnL    += pnl
            if pnl > 0
                isWins  += 1
                isGProf += pnl
            else
                isGLoss += -pnl
        if oosOne
            oosTrades += 1
            oosPnL    += pnl
            if pnl > 0
                oosWins  += 1
                oosGProf += pnl
            else
                oosGLoss += -pnl
    lastClosed := strategy.closedtrades

// =============================================================================
// Plots
// =============================================================================
plot(showSTLine and dir ==  1 ? stLine : na, "ST Up",
     color=bullCol, linewidth=2, style=plot.style_linebr)
plot(showSTLine and dir == -1 ? stLine : na, "ST Dn",
     color=bearCol, linewidth=2, style=plot.style_linebr)

barcolor(colorBars ? (dir == 1 ? bullCol : bearCol) : na)

plotshape(showLabels and newLong,  title="LONG",  style=shape.labelup,
     location=location.belowbar, color=bullCol, textcolor=color.white,
     text="L", size=size.tiny)
plotshape(showLabels and newShort, title="SHORT", style=shape.labeldown,
     location=location.abovebar, color=bearCol, textcolor=color.white,
     text="S", size=size.tiny)

bgcolor(useWF and inIS  ? color.new(bullCol, 95)      : na, title="IS Tint")
bgcolor(useWF and inOOS ? color.new(color.yellow, 95) : na, title="OOS Tint")

// TP1 / BE level lines (entry-time levels, redrawn per trade)
var line tp1Line = na
var line beLine  = na

if showLevels and (newLong or newShort)
    line.delete(tp1Line)
    line.delete(beLine)
    tp1Line := line.new(bar_index, tp1Px, bar_index + levelLen, tp1Px,
         color=color.lime,   width=1, style=line.style_dotted)
    beLine  := line.new(bar_index, bePx,  bar_index + levelLen, bePx,
         color=color.yellow, width=1, style=line.style_dashed)

// Active runner stop (only visible after TP1 has filled)
plot(tp1Hit and useBE and strategy.position_size != 0 ? bePx : na, "Runner BE",
     color=color.new(color.red, 30), style=plot.style_linebr, linewidth=2)

// =============================================================================
// IS / OOS Metrics Table
// =============================================================================
fmtPct(int wins, int n) =>
    n == 0 ? "-" : str.tostring(100.0 * wins / n, "#.0") + "%"
pf(float gProf, float gLoss) =>
    gLoss == 0.0 ? (gProf > 0.0 ? "Inf" : "-") : str.tostring(gProf / gLoss, "#.00")
avg(float pnl, int n) =>
    n == 0 ? "-" : str.tostring(pnl / n, "#.##")

var table wf = table.new(position.bottom_left, 4, 7,
     bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast and showWfTbl
    table.cell(wf, 0, 0, "Walk-Forward",  text_color=color.white,  bgcolor=color.new(color.gray, 60))
    table.cell(wf, 1, 0, "IS",            text_color=bullCol,      bgcolor=color.new(color.gray, 60))
    table.cell(wf, 2, 0, "OOS",           text_color=color.yellow, bgcolor=color.new(color.gray, 60))
    table.cell(wf, 3, 0, "All",           text_color=color.white,  bgcolor=color.new(color.gray, 60))

    allTrades = isTrades + oosTrades
    allWins   = isWins   + oosWins
    allPnL    = isPnL    + oosPnL
    allGProf  = isGProf  + oosGProf
    allGLoss  = isGLoss  + oosGLoss

    table.cell(wf, 0, 1, "Trades",        text_color=color.white)
    table.cell(wf, 1, 1, str.tostring(isTrades),   text_color=color.white)
    table.cell(wf, 2, 1, str.tostring(oosTrades),  text_color=color.white)
    table.cell(wf, 3, 1, str.tostring(allTrades),  text_color=color.white)

    table.cell(wf, 0, 2, "Win %",         text_color=color.white)
    table.cell(wf, 1, 2, fmtPct(isWins,  isTrades),  text_color=color.white)
    table.cell(wf, 2, 2, fmtPct(oosWins, oosTrades), text_color=color.white)
    table.cell(wf, 3, 2, fmtPct(allWins, allTrades), text_color=color.white)

    table.cell(wf, 0, 3, "Net P&L",       text_color=color.white)
    table.cell(wf, 1, 3, str.tostring(isPnL,  "#.##"),  text_color=isPnL  >= 0 ? bullCol : bearCol)
    table.cell(wf, 2, 3, str.tostring(oosPnL, "#.##"),  text_color=oosPnL >= 0 ? bullCol : bearCol)
    table.cell(wf, 3, 3, str.tostring(allPnL, "#.##"),  text_color=allPnL >= 0 ? bullCol : bearCol)

    table.cell(wf, 0, 4, "Avg Trade",     text_color=color.white)
    table.cell(wf, 1, 4, avg(isPnL,  isTrades),  text_color=color.white)
    table.cell(wf, 2, 4, avg(oosPnL, oosTrades), text_color=color.white)
    table.cell(wf, 3, 4, avg(allPnL, allTrades), text_color=color.white)

    table.cell(wf, 0, 5, "Profit Factor", text_color=color.white)
    table.cell(wf, 1, 5, pf(isGProf,  isGLoss),  text_color=color.white)
    table.cell(wf, 2, 5, pf(oosGProf, oosGLoss), text_color=color.white)
    table.cell(wf, 3, 5, pf(allGProf, allGLoss), text_color=color.white)

    isAvg    = isTrades  == 0 ? 0.0 : isPnL  / isTrades
    oosAvg   = oosTrades == 0 ? 0.0 : oosPnL / oosTrades
    effRatio = isAvg <= 0.0 ? 0.0 : oosAvg / isAvg
    eff      = isAvg <= 0.0 ? "-" : str.tostring(effRatio, "#.00")
    effClr   = isAvg <= 0.0 ? color.gray : effRatio >= 0.7 ? bullCol : effRatio >= 0.3 ? color.yellow : bearCol
    table.cell(wf, 0, 6, "OOS/IS Eff",    text_color=color.white)
    table.cell(wf, 1, 6, "",              text_color=color.white)
    table.cell(wf, 2, 6, "",              text_color=color.white)
    table.cell(wf, 3, 6, eff,             text_color=effClr)
