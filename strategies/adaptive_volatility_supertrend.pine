//@version=6
// =============================================================================
// Adaptive Volatility SuperTrend + MACD  (indicator)
// -----------------------------------------------------------------------------
// Visual companion to the strategy. The adaptive SuperTrend adapts its ATR
// multiplier to the volatility regime and trend efficiency, and is used as a
// regime filter + trailing reference. Entry markers fire on a MACD cross that
// agrees with the chart SuperTrend and a higher-timeframe SuperTrend, skipping
// choppy stretches. All signals are confirmed (non-repainting).
//
//   Long marker  : HTF ST bullish AND MACD bull cross while chart ST bullish
//   Short marker : HTF ST bearish AND MACD bear cross while chart ST bearish
// =============================================================================
indicator("Adaptive Volatility SuperTrend + MACD", overlay = true, max_bars_back = 500)

// -----------------------------------------------------------------------------
// INPUTS — Adaptive SuperTrend core
// -----------------------------------------------------------------------------
atrLen      = input.int(10,   "ATR Length",                minval = 1,                 group = "Adaptive SuperTrend")
baseMult    = input.float(2.8,"Base Multiplier",           minval = 0.1, step = 0.1,   group = "Adaptive SuperTrend")
srcBasis    = input.string("hl2", "Band Basis",            options = ["hl2","close","ohlc4"], group = "Adaptive SuperTrend")
volLookback = input.int(100,  "Volatility Baseline Bars",  minval = 20,                group = "Adaptive SuperTrend")
gamma       = input.float(0.65,"Volatility Elasticity",    minval = 0.1, maxval = 1.5, step = 0.05, group = "Adaptive SuperTrend",
                 tooltip = "How strongly the multiplier reacts to the vol regime. 0 = ignore, 1 = linear, >1 = aggressive.")
minMult     = input.float(1.8,"Minimum Multiplier",        minval = 0.1, step = 0.1,   group = "Adaptive SuperTrend")
maxMult     = input.float(4.2,"Maximum Multiplier",        minval = 0.1, step = 0.1,   group = "Adaptive SuperTrend")
smoothLen   = input.int(5,    "Multiplier Smoothing",      minval = 1,                 group = "Adaptive SuperTrend")
useER       = input.bool(true,"Use Efficiency-Ratio Adjustment",                       group = "Adaptive SuperTrend")
erLen       = input.int(20,   "ER Length",                 minval = 2,                 group = "Adaptive SuperTrend")
erBase      = input.float(1.08,"ER Neutral Factor",        minval = 0.5, maxval = 1.5, step = 0.01, group = "Adaptive SuperTrend",
                 tooltip = "Multiplier factor when the market is pure chop (ER = 0).")
erSlope     = input.float(0.28,"ER Trend Tightening",      minval = 0.0, maxval = 1.0, step = 0.01, group = "Adaptive SuperTrend",
                 tooltip = "How much a clean trend (ER = 1) tightens the band. Factor = erBase - erSlope*ER.")

// -----------------------------------------------------------------------------
// INPUTS — Signal (MACD + HTF permission + chop guard)
// -----------------------------------------------------------------------------
macdFast    = input.int(12, "MACD Fast",   minval = 1, group = "Signal")
macdSlow    = input.int(26, "MACD Slow",   minval = 2, group = "Signal")
macdSignal  = input.int(9,  "MACD Signal", minval = 1, group = "Signal")
useHtf      = input.bool(true, "HTF SuperTrend Permission",      group = "Signal")
htfTf       = input.timeframe("60", "HTF Timeframe",             group = "Signal")
chopLen     = input.int(8, "Chop Lookback (bars)",   minval = 2, maxval = 50, group = "Signal")
chopMax     = input.int(3, "Max ST Flips in Window", minval = 1,              group = "Signal")
showFills   = input.bool(true, "Shade trend fill",              group = "Signal")

// -----------------------------------------------------------------------------
// 1-4. Adaptive multiplier
// -----------------------------------------------------------------------------
atr       = ta.atr(atrLen)
atrPct    = atr / close
atrPctRef = ta.ema(atrPct, volLookback)
volRatio  = atrPctRef > 0 ? atrPct / atrPctRef : 1.0

rawMult   = baseMult * math.pow(volRatio, gamma)
volMult   = math.max(minMult, math.min(maxMult, rawMult))

netMove   = math.abs(close - close[erLen])
pathMove  = math.sum(math.abs(ta.change(close)), erLen)
er        = pathMove > 0 ? netMove / pathMove : 0.0
erFactor  = useER ? (erBase - erSlope * er) : 1.0

targetMult   = math.max(minMult, math.min(maxMult, volMult * erFactor))
adaptiveMult = ta.ema(targetMult, smoothLen)

// -----------------------------------------------------------------------------
// 5. Adaptive SuperTrend
// -----------------------------------------------------------------------------
basis = switch srcBasis
    "close" => close
    "ohlc4" => ohlc4
    => hl2

offset     = adaptiveMult * atr
basicUpper = basis + offset
basicLower = basis - offset

var float finalUpper = na
var float finalLower = na
var int   stDir      = 1

finalUpper := na(finalUpper[1]) ? basicUpper : (basicUpper < finalUpper[1] or close[1] > finalUpper[1]) ? basicUpper : finalUpper[1]
finalLower := na(finalLower[1]) ? basicLower : (basicLower > finalLower[1] or close[1] < finalLower[1]) ? basicLower : finalLower[1]
stDir      := na(stDir[1]) ? 1 : stDir[1] == -1 and close > finalUpper[1] ? 1 : stDir[1] == 1 and close < finalLower[1] ? -1 : stDir[1]

stLine = stDir == 1 ? finalLower : finalUpper

// HTF SuperTrend direction (previous closed HTF bar — non-repainting).
// Called unconditionally at global scope; the toggle is applied afterwards.
htfDirRaw = request.security(syminfo.tickerid, htfTf, stDir[1], lookahead = barmerge.lookahead_off)
htfDir    = useHtf ? htfDirRaw : stDir

// -----------------------------------------------------------------------------
// SIGNALS
// -----------------------------------------------------------------------------
[macdLine, sigLine, _hist] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdBull = ta.crossover(macdLine, sigLine)
macdBear = ta.crossunder(macdLine, sigLine)

stFlip     = stDir != stDir[1]
flipsInWin = math.sum(stFlip ? 1 : 0, chopLen)
choppy     = flipsInWin >= chopMax

longSig  = macdBull and stDir == 1  and (not useHtf or htfDir == 1)  and not choppy and barstate.isconfirmed
shortSig = macdBear and stDir == -1 and (not useHtf or htfDir == -1) and not choppy and barstate.isconfirmed

// -----------------------------------------------------------------------------
// PLOTS
// -----------------------------------------------------------------------------
upPlot  = plot(stDir == 1 ? stLine : na, "Up Trend",   color = color.lime, linewidth = 2, style = plot.style_linebr)
dnPlot  = plot(stDir == 1 ? na : stLine, "Down Trend", color = color.red,  linewidth = 2, style = plot.style_linebr)
midPlot = plot(showFills ? close : na, "", display = display.none, editable = false)

fill(upPlot, midPlot, color = showFills ? color.new(color.lime, 88) : na, title = "Up Fill")
fill(dnPlot, midPlot, color = showFills ? color.new(color.red, 88)  : na, title = "Down Fill")

plotshape(longSig,  "Long",  style = shape.labelup,   location = location.belowbar, color = color.lime, textcolor = color.black, text = "▲")
plotshape(shortSig, "Short", style = shape.labeldown, location = location.abovebar, color = color.red,  textcolor = color.white, text = "▼")

bgcolor(useHtf and htfDir == 1  ? color.new(color.green, 94) : na, title = "HTF bull")
bgcolor(useHtf and htfDir == -1 ? color.new(color.red,   94) : na, title = "HTF bear")

plot(adaptiveMult, "Adaptive Multiplier", color = color.aqua,   display = display.data_window)
plot(er,           "Efficiency Ratio",    color = color.orange, display = display.data_window)

// -----------------------------------------------------------------------------
// ALERTS
// -----------------------------------------------------------------------------
alertcondition(longSig,  "Long signal",  "Adaptive ST + MACD long")
alertcondition(shortSig, "Short signal", "Adaptive ST + MACD short")
