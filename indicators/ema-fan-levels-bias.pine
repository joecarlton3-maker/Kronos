//@version=6
indicator("13/48/200 EMA Fan + Key Levels Bias System", shorttitle="EMA Fan Bias", overlay=true, max_labels_count=100)

// ─────────────────────────────────────────────────────────────────────────────
// Intraday bias + signal system:
//   • 13 / 48 / 200 EMA fan (trend + "who's in control")
//   • Previous Day High/Low zones, Pre-Market High/Low levels
//   • The 4 level plays: PDH break&retest (bull), PDH reject (bear),
//     PDL bounce (bull), PDL break&retest (bear)
//   • 13/48 EMA dip entries with first-dip / re-add tracking
//   • Micro bull/bear flag breaks
//   • 13x48 EMA cross reversal confirmation
//   • Bullish bias checklist table
// Best on 2m–15m charts with extended hours ON (needed for pre-market levels).
// ─────────────────────────────────────────────────────────────────────────────

// ─── Inputs ──────────────────────────────────────────────────────────────────
grpE   = "EMA Fan"
len13  = input.int(13,  "Fast EMA",  minval=1, group=grpE)
len48  = input.int(48,  "Mid EMA",   minval=1, group=grpE)
len200 = input.int(200, "Slow EMA",  minval=1, group=grpE)
col13  = input.color(#f5d33a, "Fast", group=grpE, inline="cols")
col48  = input.color(#9c27b0, "Mid",  group=grpE, inline="cols")
col200 = input.color(#f23645, "Slow", group=grpE, inline="cols")

grpL    = "Key Levels"
showPD  = input.bool(true, "Previous day high / low zones", group=grpL)
showPM  = input.bool(true, "Pre-market high / low", group=grpL)
zonePct = input.float(0.05, "Zone half-width (% of level)", minval=0.0, step=0.01, group=grpL, tooltip="PDH/PDL are treated as zones, not exact lines. 0.05% on a $600 underlying gives a ~$0.60 wide zone.")
colPD   = input.color(#2962ff, "PDH / PDL", group=grpL, inline="lvlc")
colPM   = input.color(#787b86, "PMH / PML", group=grpL, inline="lvlc")

grpS       = "Signals"
showDips   = input.bool(true, "EMA pullback (dip) signals", group=grpS)
showFlags  = input.bool(true, "Micro flag break signals", group=grpS)
showCross  = input.bool(true, "13/48 EMA cross + reversal confirmation", group=grpS)
showLevels = input.bool(true, "PDH / PDL reject, bounce, break & retest", group=grpS)
coolBars   = input.int(6, "Min bars between level signals", minval=0, group=grpS, tooltip="Cooldown so a choppy fight at a level doesn't spam signals.")
chopFilter = input.bool(true, "Mute trend entries inside PMH–PML chop range", group=grpS, tooltip="Avoid trading anything between the pre-market high and low. While price is inside that range, EMA dip, flag, and 13/48 cross signals are muted. Level plays and PMH/PML breaks still fire.")
rthOnly    = input.bool(true, "Signals during regular hours only", group=grpS, tooltip="Suppress all signals outside the cash session. Levels and EMAs still draw on extended-hours bars.")
crossGap   = input.int(10, "13/48 cross whipsaw filter (min bars)", minval=0, group=grpS, tooltip="A 13/48 cross only signals if the previous cross was at least this many bars ago. Kills the braided-EMA spam on rangebound days.")

grpA     = "Alerts"
alertsOn = input.bool(true, "Enable alert() events", group=grpA, tooltip="Create ONE TradingView alert on this indicator with condition 'Any alert() function call' and you'll receive every signal below. Signals are gated by their display toggles — hide a signal group to also mute its alerts.")

grpT      = "Table"
showTable = input.bool(true, "Bias checklist table", group=grpT)
tblPosStr = input.string("Top right", "Table position", options=["Top right", "Top left", "Bottom right", "Bottom left"], group=grpT)

// ─── EMA fan ─────────────────────────────────────────────────────────────────
ema13  = ta.ema(close, len13)
ema48  = ta.ema(close, len48)
ema200 = ta.ema(close, len200)

bullFan  = ema13 > ema48 and ema48 > ema200
bearFan  = ema13 < ema48 and ema48 < ema200
above200 = close > ema200
aboveAll = close > ema13 and close > ema48 and close > ema200
belowAll = close < ema13 and close < ema48 and close < ema200
trendUp  = bullFan and above200
trendDn  = bearFan and not above200

// ─── Key levels ──────────────────────────────────────────────────────────────
newDay = timeframe.change("D")

// Previous CASH SESSION high/low, tracked bar-by-bar from regular-hours data
// only — a daily request.security would include extended hours whenever the
// chart shows them, which is not what "previous day high/low" means here.
firstRthBar = session.ismarket and (not session.ismarket[1] or newDay)

var float rthHigh = na
var float rthLow  = na
var float pdh     = na
var float pdl     = na
if firstRthBar
    pdh     := rthHigh
    pdl     := rthLow
    rthHigh := high
    rthLow  := low
else if session.ismarket
    rthHigh := math.max(nz(rthHigh, high), high)
    rthLow  := math.min(nz(rthLow, low), low)

var float pmHigh = na
var float pmLow  = na
if newDay
    pmHigh := na
    pmLow  := na
if session.ispremarket
    pmHigh := na(pmHigh) ? high : math.max(pmHigh, high)
    pmLow  := na(pmLow)  ? low  : math.min(pmLow, low)

zoneWH = pdh * zonePct / 100
zoneWL = pdl * zonePct / 100

// RTH open — decides whether PDH acts as resistance or the day's main support
var float rthOpen = na
if newDay
    rthOpen := na
if na(rthOpen) and session.ismarket
    rthOpen := open
openAbovePdh = not na(rthOpen) and rthOpen > pdh
openBelowPdl = not na(rthOpen) and rthOpen < pdl

// Session gate for signals — you trade the cash session, not the halo around it
sigSession = not rthOnly or session.ismarket

// ─── Level break state (for break & retest vs. first-touch plays) ────────────
crossUpPdh = ta.crossover(close, pdh)
crossDnPdl = ta.crossunder(close, pdl)

var bool brokePdhUp = false
var bool brokePdlDn = false
if newDay
    brokePdhUp := false
    brokePdlDn := false
if crossUpPdh
    brokePdhUp := true
if crossDnPdl
    brokePdlDn := true
// Losing the level entirely invalidates the breakout state
if brokePdhUp and close < pdh - zoneWH
    brokePdhUp := false
if brokePdlDn and close > pdl + zoneWL
    brokePdlDn := false

// ─── The 4 level plays ───────────────────────────────────────────────────────
var int lastLvlBar = na
canLvl = na(lastLvlBar) or bar_index - lastLvlBar >= coolBars

// 1) Reject at PDH = bearish: tags the zone from below, closes red under the level
rejectPdhSig = not brokePdhUp and close[1] < pdh and high >= pdh - zoneWH and close < pdh and close < open and canLvl and sigSession and barstate.isconfirmed
// 2) Break & retest PDH holds = bullish: broke above, dips back into the zone, holds
retestPdhSig = brokePdhUp and low <= pdh + zoneWH and low[1] > pdh + zoneWH and close > pdh and canLvl and sigSession and barstate.isconfirmed
// 3) Bounce at PDL = bullish: tags the zone from above, closes green over the level
bouncePdlSig = not brokePdlDn and close[1] > pdl and low <= pdl + zoneWL and close > pdl and close > open and canLvl and sigSession and barstate.isconfirmed
// 4) Break & retest PDL fails = bearish: broke below, pops back into the zone, rejects
retestPdlSig = brokePdlDn and high >= pdl - zoneWL and high[1] < pdl - zoneWL and close < pdl and canLvl and sigSession and barstate.isconfirmed

// 5) Opened above PDH → PDH is the day's main support: dip into the zone that holds = bullish
pdhSupSig = openAbovePdh and close[1] > pdh and low <= pdh + zoneWH and close > pdh and close > open and canLvl and sigSession and barstate.isconfirmed
// 6) Opened below PDL → PDL is the day's main resistance: pop into the zone that fails = bearish
pdlResSig = openBelowPdl and close[1] < pdl and high >= pdl - zoneWL and close < pdl and close < open and canLvl and sigSession and barstate.isconfirmed

var int lastRejBar = na
var int lastBncBar = na
if rejectPdhSig or retestPdhSig or bouncePdlSig or retestPdlSig or pdhSupSig or pdlResSig
    lastLvlBar := bar_index
if rejectPdhSig or pdlResSig
    lastRejBar := bar_index
if bouncePdlSig or pdhSupSig
    lastBncBar := bar_index

// ─── Pre-market level breaks (one-shot per day) ──────────────────────────────
crossUpPmh = ta.crossover(close, pmHigh)
crossDnPml = ta.crossunder(close, pmLow)

var bool pmhBroken = false
var bool pmlBroken = false
if newDay
    pmhBroken := false
    pmlBroken := false
pmhBreakSig = not pmhBroken and crossUpPmh and session.ismarket and barstate.isconfirmed
pmlBreakSig = not pmlBroken and crossDnPml and session.ismarket and barstate.isconfirmed
if pmhBreakSig
    pmhBroken := true
if pmlBreakSig
    pmlBroken := true

// Chop range: price stuck between the pre-market high and low
inChop   = not na(pmHigh) and not na(pmLow) and close < pmHigh and close > pmLow
chopMute = chopFilter and inChop

// ─── EMA dip / pop signals ───────────────────────────────────────────────────
touch13  = low <= ema13 and low[1] > ema13[1]
touch48  = low <= ema48 and low[1] > ema48[1]
dip13Sig = trendUp and touch13 and close > ema13 and not chopMute and sigSession and barstate.isconfirmed
dip48Sig = trendUp and touch48 and close > ema48 and not chopMute and sigSession and barstate.isconfirmed
pop13Sig = trendDn and high >= ema13 and high[1] < ema13[1] and close < ema13 and not chopMute and sigSession and barstate.isconfirmed

// 13/48 crosses with whipsaw filter: when the EMAs braid in chop they cross
// every few bars — only the first cross after a stable stretch is a signal
crossBull = ta.crossover(ema13, ema48)
crossBear = ta.crossunder(ema13, ema48)

var int lastXBar = na
xSpaced = na(lastXBar) or bar_index - lastXBar >= crossGap
crossBullSig = crossBull and xSpaced and not chopMute and sigSession and barstate.isconfirmed
crossBearSig = crossBear and xSpaced and not chopMute and sigSession and barstate.isconfirmed
if crossBull or crossBear
    lastXBar := bar_index

// First dip vs. re-add tracking: count resets when the leg breaks (close under 48)
legEndBull = ta.crossunder(close, ema48)

var int dipCount = 0
if legEndBull or crossBear
    dipCount := 0
if dip13Sig
    dipCount += 1
dip13First = dip13Sig and dipCount == 1
dip13ReAdd = dip13Sig and dipCount == 2
dip13Later = dip13Sig and dipCount > 2

// ─── Micro flag breaks ───────────────────────────────────────────────────────
// Two lower-high pullback bars holding the fan, then a close through the prior high
bullFlagSig = trendUp and close > ema13 and low > ema48 and close > high[1] and high[1] < high[2] and high[2] < high[3] and not chopMute and sigSession and barstate.isconfirmed
bearFlagSig = trendDn and close < ema13 and high < ema48 and close < low[1] and low[1] > low[2] and low[2] > low[3] and not chopMute and sigSession and barstate.isconfirmed

// ─── Reversal confirmation: level play + EMA cross agree ─────────────────────
revConfBear = crossBearSig and not na(lastRejBar) and bar_index - lastRejBar <= 20
revConfBull = crossBullSig and not na(lastBncBar) and bar_index - lastBncBar <= 20

// ─── Bias score ──────────────────────────────────────────────────────────────
bullPts = (close > pdh ? 1 : 0) + (not na(pmHigh) and close > pmHigh ? 1 : 0) + (bullFan ? 1 : 0) + (above200 ? 1 : 0)
bearPts = (close < pdl ? 1 : 0) + (not na(pmLow) and close < pmLow ? 1 : 0) + (bearFan ? 1 : 0) + (not above200 ? 1 : 0)

biasTxt = switch
    bullPts == 4 => "FULL BULL — CALLS ONLY"
    bullPts == 3 => "BULLISH"
    bearPts == 4 => "FULL BEAR — PUTS ONLY"
    bearPts == 3 => "BEARISH"
    above200     => "LEAN BULLISH"
    => "LEAN BEARISH"

biasCol = switch
    bullPts >= 3 => color.new(#089981, 0)
    bearPts >= 3 => color.new(#f23645, 0)
    above200     => color.new(#4caf50, 0)
    => color.new(#ef5350, 0)

aboveAllFlipUp = aboveAll and not aboveAll[1] and sigSession and barstate.isconfirmed
belowAllFlipDn = belowAll and not belowAll[1] and sigSession and barstate.isconfirmed

bsFlagUp     = ta.barssince(bullFlagSig)
flagRecentUp = not na(bsFlagUp) and bsFlagUp <= 30

// ─── Plots: EMAs, levels, zones ──────────────────────────────────────────────
plot(ema13,  "13 EMA",  col13,  2)
plot(ema48,  "48 EMA",  col48,  2)
plot(ema200, "200 EMA", col200, 2)

hidden = color.new(color.blue, 100)
plot(showPD ? pdh : na, "PDH", colPD, 2, plot.style_linebr)
plot(showPD ? pdl : na, "PDL", colPD, 2, plot.style_linebr)
pdhTop = plot(showPD ? pdh + zoneWH : na, "PDH zone top",    hidden, editable=false)
pdhBot = plot(showPD ? pdh - zoneWH : na, "PDH zone bottom", hidden, editable=false)
pdlTop = plot(showPD ? pdl + zoneWL : na, "PDL zone top",    hidden, editable=false)
pdlBot = plot(showPD ? pdl - zoneWL : na, "PDL zone bottom", hidden, editable=false)
fill(pdhTop, pdhBot, color=color.new(colPD, 85), title="PDH zone")
fill(pdlTop, pdlBot, color=color.new(colPD, 85), title="PDL zone")

pmhPlot = plot(showPM ? pmHigh : na, "Pre-market high", colPM, 1, plot.style_circles)
pmlPlot = plot(showPM ? pmLow  : na, "Pre-market low",  colPM, 1, plot.style_circles)
fill(pmhPlot, pmlPlot, color=showPM and inChop ? color.new(colPM, 92) : na, title="PMH–PML chop range")

// ─── Signal shapes ───────────────────────────────────────────────────────────
plotshape(showDips and dip13First, "13 EMA first dip",  shape.triangleup,   location.belowbar, color=col13, text="DIP", textcolor=col13, size=size.tiny)
plotshape(showDips and dip13ReAdd, "13 EMA re-add dip", shape.triangleup,   location.belowbar, color=col13, text="ADD", textcolor=col13, size=size.tiny)
plotshape(showDips and dip13Later, "13 EMA later dip",  shape.triangleup,   location.belowbar, color=color.new(#f5d33a, 40), size=size.tiny)
plotshape(showDips and dip48Sig,   "48 EMA dip",        shape.triangleup,   location.belowbar, color=col48, text="48",  textcolor=col48, size=size.tiny)
plotshape(showDips and pop13Sig,   "13 EMA pop",        shape.triangledown, location.abovebar, color=col13, text="POP", textcolor=col13, size=size.tiny)

plotshape(showFlags and bullFlagSig, "Bull flag break", shape.flag, location.belowbar, color=color.new(#089981, 0), size=size.tiny)
plotshape(showFlags and bearFlagSig, "Bear flag break", shape.flag, location.abovebar, color=color.new(#f23645, 0), size=size.tiny)

plotshape(showCross and crossBullSig, "Bullish 13/48 cross", shape.xcross, location.belowbar, color=color.new(#089981, 0), size=size.tiny)
plotshape(showCross and crossBearSig, "Bearish 13/48 cross", shape.xcross, location.abovebar, color=color.new(#f23645, 0), size=size.tiny)
plotshape(showCross and revConfBull, "Reversal confirmed up",   shape.labelup,   location.belowbar, color=color.new(#089981, 0), text="REV", textcolor=color.white, size=size.tiny)
plotshape(showCross and revConfBear, "Reversal confirmed down", shape.labeldown, location.abovebar, color=color.new(#f23645, 0), text="REV", textcolor=color.white, size=size.tiny)

plotshape(showLevels and rejectPdhSig, "PDH rejection",          shape.triangledown, location.abovebar, color=color.new(#f23645, 0), text="REJ", textcolor=color.new(#f23645, 0), size=size.tiny)
plotshape(showLevels and retestPdhSig, "PDH break&retest hold",  shape.triangleup,   location.belowbar, color=color.new(#089981, 0), text="B&R", textcolor=color.new(#089981, 0), size=size.tiny)
plotshape(showLevels and bouncePdlSig, "PDL bounce",             shape.triangleup,   location.belowbar, color=color.new(#089981, 0), text="BNC", textcolor=color.new(#089981, 0), size=size.tiny)
plotshape(showLevels and retestPdlSig, "PDL break&retest fail",  shape.triangledown, location.abovebar, color=color.new(#f23645, 0), text="B&R", textcolor=color.new(#f23645, 0), size=size.tiny)
plotshape(showLevels and pdhSupSig,    "PDH support hold",       shape.triangleup,   location.belowbar, color=color.new(#089981, 0), text="SUP", textcolor=color.new(#089981, 0), size=size.tiny)
plotshape(showLevels and pdlResSig,    "PDL resistance fail",    shape.triangledown, location.abovebar, color=color.new(#f23645, 0), text="RES", textcolor=color.new(#f23645, 0), size=size.tiny)
plotshape(showLevels and pmhBreakSig,  "PMH resistance break",   shape.triangleup,   location.belowbar, color=colPM, text="BRK", textcolor=color.new(#089981, 0), size=size.tiny)
plotshape(showLevels and pmlBreakSig,  "PML support break",      shape.triangledown, location.abovebar, color=colPM, text="BRK", textcolor=color.new(#f23645, 0), size=size.tiny)

// ─── Level name labels (right edge) ──────────────────────────────────────────
var label pdhLbl = na
var label pdlLbl = na
var label pmhLbl = na
var label pmlLbl = na
if barstate.islast
    if showPD and na(pdhLbl)
        pdhLbl := label.new(bar_index, pdh, "PDH", style=label.style_label_left, color=color.new(colPD, 100), textcolor=colPD, size=size.small)
    if showPD and na(pdlLbl)
        pdlLbl := label.new(bar_index, pdl, "PDL", style=label.style_label_left, color=color.new(colPD, 100), textcolor=colPD, size=size.small)
    if showPM and na(pmhLbl) and not na(pmHigh)
        pmhLbl := label.new(bar_index, pmHigh, "PMH", style=label.style_label_left, color=color.new(colPM, 100), textcolor=colPM, size=size.small)
    if showPM and na(pmlLbl) and not na(pmLow)
        pmlLbl := label.new(bar_index, pmLow, "PML", style=label.style_label_left, color=color.new(colPM, 100), textcolor=colPM, size=size.small)
    if not na(pdhLbl)
        label.set_xy(pdhLbl, bar_index + 2, pdh)
    if not na(pdlLbl)
        label.set_xy(pdlLbl, bar_index + 2, pdl)
    if not na(pmhLbl)
        label.set_xy(pmhLbl, bar_index + 2, pmHigh)
    if not na(pmlLbl)
        label.set_xy(pmlLbl, bar_index + 2, pmLow)

// ─── Bias checklist table ────────────────────────────────────────────────────
chk(ok) => ok ? "✅" : "❌"

tblPos = switch tblPosStr
    "Top right"    => position.top_right
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    => position.bottom_left

var table biasTbl = na
if showTable and barstate.islast
    bool firstBuild = na(biasTbl)
    if firstBuild
        biasTbl := table.new(tblPos, 2, 8, bgcolor=color.new(#131722, 15), frame_width=1, frame_color=color.new(#363a45, 0), border_width=1, border_color=color.new(#363a45, 0))
    txtCol = color.new(#d1d4dc, 0)
    table.cell(biasTbl, 0, 0, "BIAS CHECKLIST", text_color=color.white, text_size=size.small, bgcolor=color.new(#2962ff, 40))
    pdhRowTxt = openAbovePdh ? "Above PDH — main support" : "Above prev day high"
    table.cell(biasTbl, 0, 1, pdhRowTxt,               text_color=txtCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(biasTbl, 1, 1, chk(close > pdh), text_size=size.tiny)
    table.cell(biasTbl, 0, 2, "Above pre-market high", text_color=txtCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(biasTbl, 1, 2, na(pmHigh) ? "—" : chk(close > pmHigh), text_color=txtCol, text_size=size.tiny)
    table.cell(biasTbl, 0, 3, "Bullish EMA fan (13>48>200)", text_color=txtCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(biasTbl, 1, 3, chk(bullFan), text_size=size.tiny)
    table.cell(biasTbl, 0, 4, "Above 200 EMA",         text_color=txtCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(biasTbl, 1, 4, chk(above200), text_size=size.tiny)
    table.cell(biasTbl, 0, 5, "Bull-flaggy price action", text_color=txtCol, text_size=size.tiny, text_halign=text.align_left)
    table.cell(biasTbl, 1, 5, chk(flagRecentUp), text_size=size.tiny)
    table.cell(biasTbl, 0, 6, biasTxt, text_color=biasCol, text_size=size.small)
    guideTxt = inChop ? "Chop: inside PMH–PML — be patient" : close > ema13 and close > ema48 ? "No shorts above the 13/48" : close < ema13 and close < ema48 ? "No longs below the 13/48" : "Mixed — wait for structure"
    table.cell(biasTbl, 0, 7, guideTxt, text_color=color.new(#b2b5be, 0), text_size=size.tiny)
    if firstBuild
        table.merge_cells(biasTbl, 0, 0, 1, 0)
        table.merge_cells(biasTbl, 0, 6, 1, 6)
        table.merge_cells(biasTbl, 0, 7, 1, 7)

// ─── Alerts ──────────────────────────────────────────────────────────────────
// alert() instead of alertcondition() — alertconditions count toward the
// 64-output plot limit; alert() calls don't. Set up ONE alert on this
// indicator with condition "Any alert() function call" to receive all of these.
if alertsOn
    sym = syminfo.ticker + ": "
    if showDips and dip13First
        alert(sym + "Bullish — first 13 EMA dip of the leg (trend entry zone)", alert.freq_once_per_bar)
    if showDips and dip13ReAdd
        alert(sym + "Bullish — second 13 EMA dip (re-add spot if it holds)", alert.freq_once_per_bar)
    if showDips and dip48Sig
        alert(sym + "Bullish — deeper pullback into the 48 EMA holding trend", alert.freq_once_per_bar)
    if showDips and pop13Sig
        alert(sym + "Bearish — rally into the 13 EMA in a downtrend (short-the-pop zone)", alert.freq_once_per_bar)
    if showFlags and bullFlagSig
        alert(sym + "Bull flag micro-break — pullback held the fan, broke prior high", alert.freq_once_per_bar)
    if showFlags and bearFlagSig
        alert(sym + "Bear flag micro-break — pop failed at the fan, broke prior low", alert.freq_once_per_bar)
    if showCross and crossBullSig
        alert(sym + "Bullish 13/48 EMA cross", alert.freq_once_per_bar)
    if showCross and crossBearSig
        alert(sym + "Bearish 13/48 EMA cross — short-term trend shift", alert.freq_once_per_bar)
    if showCross and revConfBull
        alert(sym + "REVERSAL CONFIRMED UP — PDL bounce + bullish 13/48 cross", alert.freq_once_per_bar)
    if showCross and revConfBear
        alert(sym + "REVERSAL CONFIRMED DOWN — PDH reject + bearish 13/48 cross", alert.freq_once_per_bar)
    if showLevels and rejectPdhSig
        alert(sym + "Rejected at the previous day high zone — bearish", alert.freq_once_per_bar)
    if showLevels and retestPdhSig
        alert(sym + "PDH break & retest HELD — bullish", alert.freq_once_per_bar)
    if showLevels and bouncePdlSig
        alert(sym + "Bounced off the previous day low zone — bullish", alert.freq_once_per_bar)
    if showLevels and retestPdlSig
        alert(sym + "PDL break & retest FAILED — bearish", alert.freq_once_per_bar)
    if showLevels and pdhSupSig
        alert(sym + "Opened above PDH — dip into the zone held as support, bullish", alert.freq_once_per_bar)
    if showLevels and pdlResSig
        alert(sym + "Opened below PDL — pop into the zone failed as resistance, bearish", alert.freq_once_per_bar)
    if showLevels and pmhBreakSig
        alert(sym + "Broke the pre-market high — calls trigger", alert.freq_once_per_bar)
    if showLevels and pmlBreakSig
        alert(sym + "Broke the pre-market low — puts trigger", alert.freq_once_per_bar)
    if aboveAllFlipUp
        alert(sym + "BULLS TAKE FULL CONTROL — price above all 3 EMAs, calls only", alert.freq_once_per_bar)
    if belowAllFlipDn
        alert(sym + "BEARS TAKE FULL CONTROL — price below all 3 EMAs, puts only", alert.freq_once_per_bar)
